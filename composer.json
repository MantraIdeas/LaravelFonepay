{
    "name": "mantraideas/laravel-fonepay",
    "description": "FonePay Payment Gateway Integration for Laravel",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Mantraideas\\LaravelFonepay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.1",
        "laravel/framework": "^12.0|^13.0"
    },
    "minimum-stability": "dev",
    "extra": {
        "laravel": {
            "providers": [
                "Mantraideas\\LaravelFonepay\\LaravelFonepayServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "rector/rector": "^2.0",
        "laravel/pint": "^1.27",
        "phpstan/phpstan": "2.2.x-dev"
    },
    "scripts": {
        "test": "pest",
        "lint": [
            "@pint",
            "@pint:test",
            "@analyse",
            "@rector",
            "@rector:check"
        ],
        "lint:fix": [
            "@pint"
        ],
        "pint": "pint",
        "pint:test": "pint --test",
        "analyse": "phpstan analyse src --level=max --memory-limit=1G",
        "rector": "rector process --config=rector.php",
        "rector:check": "rector process --dry-run --config=rector.php"
    }
}
